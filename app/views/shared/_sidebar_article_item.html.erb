<% thumb = article_hero_image_url(article, preset: :thumb) %>
<li class="lawrence-card-link py-4 first:pt-0">
  <div class="flex gap-3">
    <% if thumb.present? %>
      <a href="<%= url_for article %>" class="editorial-link shrink-0">
        <div class="h-14 w-20 overflow-hidden rounded border border-line bg-line/10">
          <img src="<%= thumb %>" alt="" class="h-full w-full object-cover" loading="lazy" />
        </div>
      </a>
    <% end %>
    <div class="min-w-0 flex-1">
      <a href="<%= url_for article %>" class="editorial-link font-display text-base font-semibold leading-snug text-ink hover:text-accent"><%= article.title %></a>
      <p class="mt-2 font-ui text-xs text-muted">
        <% article.authors.each_with_index do |author, i| %>
          <a href="<%= url_for author %>" class="editorial-link text-muted hover:text-ink"><%= author.fullname %><%= author.gradyear.blank? ? "" : " ’#{author.gradyear.to_s[-2..]}" %></a><%= (article.authors.count > 2 && i != article.authors.count - 1) ? ", " : "" %><%= (article.authors.count > 1 && i == article.authors.count - 2) ? " and " : "" %>
        <% end %>
      </p>
    </div>
  </div>
</li>
