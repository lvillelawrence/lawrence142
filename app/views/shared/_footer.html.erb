<% m = @layout_shell_meta || {} %>
<footer class="border-t border-line bg-paper">
  <div class="site-container py-14">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <a href="/" class="inline-flex items-center gap-2">
          <% if m[:logo_path].present? %>
            <img src="<%= m[:logo_path] %>" alt="" class="site-logo h-7 w-auto" />
          <% end %>
          <span class="font-display text-lg font-semibold text-ink">The Lawrence</span>
        </a>
        <p class="mt-4 font-body text-sm leading-relaxed text-muted">Independent student journalism from the Lawrenceville School since 1881.</p>
        <p class="mt-4 font-ui text-xs text-muted">© <em>The Lawrence</em> <%= Time.current.year %></p>
        <p class="mt-2 font-ui text-xs text-muted">Site by Noah Trupin ’23</p>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3 lg:col-span-8">
        <div>
          <h3 class="font-ui text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-ink">Sections</h3>
          <ul class="mt-4 space-y-2">
            <% [["News", "/sections/news"], ["Opinions", "/sections/opinions"], ["Features", "/sections/features"], ["Arts", "/sections/arts"], ["Sports", "/sections/sports"], ["Editorials", "/sections/editorials"]].each do |label, href| %>
              <li><a href="<%= href %>" class="editorial-link font-body text-sm text-muted"><%= label %></a></li>
            <% end %>
            <li><a href="/issues" class="editorial-link font-body text-sm text-muted">Issues</a></li>
          </ul>
        </div>
        <div>
          <h3 class="font-ui text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-ink">Pages</h3>
          <ul class="mt-4 space-y-2">
            <% [["Masthead", "/masthead"], ["About", "/about"], ["Contact", "/contact"], ["Charter", "/charter"], ["Subscribe", "/subscribe"], ["Search", "/search"]].each do |label, href| %>
              <li><a href="<%= href %>" class="editorial-link font-body text-sm text-muted"><%= label %></a></li>
            <% end %>
          </ul>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <h3 class="font-ui text-[0.65rem] font-semibold uppercase tracking-[0.2em] text-ink">Other</h3>
          <ul class="mt-4 space-y-2">
            <li><a href="https://digitalarchives.lawrenceville.org/olive/apa/lawrenceville/" class="editorial-link font-body text-sm text-muted">Archives</a></li>
            <li><a href="/colophon" class="editorial-link font-body text-sm text-muted">Colophon</a></li>
            <li><a href="/admins/sign_in" class="editorial-link font-body text-sm text-muted">Editor Login</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>
