<% m = @layout_shell_meta || {} %>
<header class="site-header" data-controller="header">
  <div class="site-container">
    <div class="site-header__bar flex items-center justify-between gap-2 md:items-end md:gap-4">
      <div class="flex min-w-0 shrink-0 items-center gap-1.5 md:min-w-[7rem] md:gap-2">
        <button
          type="button"
          class="site-header__menu-btn"
          aria-expanded="false"
          aria-controls="lawrence-sections-menu"
          data-action="header#toggleMenu"
          data-header-target="menuButton"
        >
          <span class="site-header__menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="site-header__menu-label hidden font-ui text-[0.65rem] font-semibold uppercase tracking-[0.14em] sm:inline">Menu</span>
        </button>
        <div class="site-header__meta hidden flex-col md:flex">
          <span class="font-ui text-[0.65rem] font-medium text-muted"><%= m[:date_line] %></span>
          <a href="/issues/latest" class="editorial-link mt-0.5 font-ui text-[0.65rem] font-medium text-ink transition-colors hover:text-accent">Latest Issue</a>
        </div>
      </div>

      <a href="/" class="site-header__brand flex flex-1 flex-col items-center md:flex-initial">
        <span class="site-header__logo-wrap">
          <img src="<%= m[:logo_path] %>" alt="The Lawrence" class="site-logo site-header__logo transition-opacity hover:opacity-85" />
        </span>
        <span class="site-header__tagline-wrap">
          <span class="site-header__tagline"><%= m[:tagline] %></span>
        </span>
      </a>

      <div class="flex min-w-0 shrink-0 items-center justify-end gap-1 md:min-w-[7rem] md:gap-2">
        <%= render "shared/header_icons", meta: m %>
        <button type="button" data-theme-toggle class="theme-toggle-btn">
          <span class="theme-toggle-moon inline-flex" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
            </svg>
          </span>
          <span class="theme-toggle-sun hidden items-center justify-center" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
            </svg>
          </span>
        </button>
        <a href="/subscribe" class="hidden font-ui text-[0.65rem] font-semibold uppercase tracking-[0.12em] text-accent transition-colors hover:text-accentMuted md:inline">Subscribe</a>
        <a href="/search" class="text-ink transition-colors hover:text-accent md:hidden" aria-label="Search">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
          </svg>
        </a>
      </div>
    </div>

    <nav class="site-header__nav hidden border-t border-line md:block" aria-label="Main">
      <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 py-2.5">
        <% nav = [["Masthead", "/masthead", true], ["News", "/sections/news", false], ["Opinion", "/sections/opinions", false], ["Features", "/sections/features", false], ["Arts", "/sections/arts", false], ["Sports", "/sections/sports", false], ["Editorials", "/sections/editorials", false], ["Issues", "/issues", false], ["Search", "/search", false], ["Contact", "/contact", true]] %>
        <% nav.each do |label, href, muted| %>
          <li>
            <a href="<%= href %>" class="nav-link editorial-link px-1 py-1 font-ui text-[0.68rem] font-medium uppercase tracking-[0.14em] transition-colors hover:text-accent <%= muted ? 'text-muted' : 'text-ink' %>"><%= label %></a>
          </li>
        <% end %>
      </ul>
    </nav>
  </div>

  <%= render "shared/sections_menu", meta: m %>
</header>
