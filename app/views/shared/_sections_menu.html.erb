<% m = local_assigns[:meta] || @layout_shell_meta || {} %>
<div
  id="lawrence-sections-menu"
  class="site-nav-panel"
  aria-hidden="true"
  data-header-target="menu"
>
  <div class="site-nav-panel__accent" aria-hidden="true"></div>
  <div class="site-nav-panel__inner site-container pb-10 pt-8">
    <div class="site-nav-panel__grid grid gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-7">
        <p class="font-ui text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-accent">Sections</p>
        <ul class="mt-5 grid gap-2 sm:grid-cols-2 sm:gap-3">
          <% [
            ["News", "/sections/news", "Campus & community"],
            ["Opinion", "/sections/opinions", "Voices & debate"],
            ["Features", "/sections/features", "Profiles & Interviews"],
            ["Arts", "/sections/arts", "Culture & reviews"],
            ["Sports", "/sections/sports", "Big Red athletics and beyond"],
            ["Editorials", "/sections/editorials", "146th Board's views"],
          ].each_with_index do |(label, href, desc), i| %>
            <li class="site-nav-panel__item" style="animation-delay: <%= 0.04 + i * 0.04 %>s">
              <a href="<%= href %>" class="site-nav-panel__section-link group block rounded-lg px-3 py-3 transition-colors duration-200 hover:bg-line/25" data-action="header#closeMenu">
                <span class="font-display text-2xl font-semibold tracking-tight text-ink transition-colors group-hover:text-accent"><%= label %></span>
                <span class="mt-0.5 block font-ui text-xs text-muted"><%= desc %></span>
              </a>
            </li>
          <% end %>
        </ul>
      </div>

      <div class="md:col-span-5 md:border-l md:border-line md:pl-8">
        <p class="font-ui text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-muted">Quick links</p>
        <ul class="mt-5 space-y-1">
          <% [["Latest Issue", "/issues/latest", false], ["Masthead", "/masthead", false], ["About", "/about", false], ["Subscribe", "/subscribe", true]].each_with_index do |(label, href, accent), i| %>
            <li class="site-nav-panel__item" style="animation-delay: <%= 0.2 + i * 0.035 %>s">
              <a href="<%= href %>" class="site-nav-panel__quick-link block rounded px-3 py-2 font-ui text-sm font-medium tracking-wide transition-colors duration-200 hover:bg-line/25 <%= accent ? 'text-accent hover:text-accentMuted' : 'text-ink hover:text-accent' %>" data-action="header#closeMenu"><%= label %></a>
            </li>
          <% end %>
        </ul>

        <div class="site-nav-panel__item mt-8 border-t border-line pt-6" style="animation-delay: 0.38s">
          <p class="font-body text-sm leading-relaxed text-muted"><%= m[:tagline] %></p>
          <div class="mt-3 flex flex-wrap gap-4">
            <a href="<%= m[:instagram_url] %>" target="_blank" rel="noreferrer" class="font-ui text-xs font-medium uppercase tracking-wider text-ink transition-colors hover:text-accent" data-action="header#closeMenu">Instagram</a>
            <a href="/search" class="font-ui text-xs font-medium uppercase tracking-wider text-ink transition-colors hover:text-accent" data-action="header#closeMenu">Search</a>
            <a href="/contact" class="font-ui text-xs font-medium uppercase tracking-wider text-muted transition-colors hover:text-accent" data-action="header#closeMenu">Contact</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
