<div class="space-y-10">
  <header class="border-b border-line pb-8">
    <h1 class="font-display text-4xl font-semibold tracking-tight text-ink"><%= @author.firstname %> <%= @author.lastname %></h1>
    <% if @author.gradyear.present? || @author.position.present? %>
      <p class="mt-2 font-ui text-sm text-muted">
        <%= @author.gradyear.present? ? "’#{@author.gradyear.to_s[-2..]}" : "" %>
        <%= @author.position.present? ? " · #{@author.position}" : "" %>
      </p>
    <% end %>
  </header>
  <div class="grid gap-10 sm:grid-cols-2">
    <% @author.articles.each do |article| %>
      <article class="border-t border-line pt-6">
        <a href="<%= url_for article %>" class="editorial-link block">
          <h2 class="font-display text-xl font-semibold leading-snug text-ink transition-colors duration-editorial hover:text-accent"><%= article.title %></h2>
          <p class="mt-2 font-ui text-xs text-muted">
            <% article.authors.each_with_index do |author, i| %>
              <a href="<%= url_for author %>" class="editorial-link text-muted hover:text-ink"><%= author.fullname %><%= author.gradyear.blank? ? "" : " ’#{author.gradyear.to_s[-2..]}" %></a><%= (article.authors.count > 2 && i != article.authors.count - 1) ? ", " : "" %><%= (article.authors.count > 1 && i == article.authors.count - 2) ? " and " : "" %>
            <% end %>
          </p>
          <p class="mt-3 font-body text-sm leading-relaxed text-muted line-clamp-4">
            <%= (lambda { |text| text.split[0...[text.length, 30].min].join(" ") }).call(article.body.to_plain_text) %>…
          </p>
        </a>
      </article>
    <% end %>
  </div>
</div>
<% if admin_signed_in? %>
  <div class="mt-10 flex flex-wrap gap-4 border-t border-line pt-6 font-ui text-sm">
    <%= link_to "Edit", edit_author_path(@author), class: "text-accent hover:text-accentMuted" %>
    <%= button_to "Destroy", author_path(@author), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "cursor-pointer border-0 bg-transparent p-0 font-ui text-sm text-accentMuted underline decoration-line hover:text-accent" %>
  </div>
<% end %>
