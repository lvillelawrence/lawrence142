<article>
  <header class="article-header">
    <h1 class="font-display text-4xl font-semibold tracking-tight text-ink sm:text-5xl"><%= @article.title %></h1>
    <p class="mt-4 font-ui text-sm leading-relaxed text-muted">
      <% @article.authors.each_with_index do |author, i| %>
        <a href="<%= url_for author %>" class="editorial-link font-medium text-accent hover:text-accentMuted">
          <%= author.fullname %><%= author.gradyear.blank? ? "" : " ’#{author.gradyear.to_s[-2..]}" %><%= author.position.present? ? " (#{author.position})" : "" %>
        </a><%= (@article.authors.count > 2 && i != @article.authors.count - 1) ? ", " : "" %><%= (@article.authors.count > 1 && i == @article.authors.count - 2) ? " and " : "" %>
      <% end %>
      <span class="text-line"> | </span>
      <a href="/sections/<%= @article.section&.downcase %>" class="editorial-link italic text-ink hover:text-accent"><%= @article.section %></a>
      <span class="text-line"> | </span>
      <span class="text-muted"><%= @article.published_at_for_display %></span>
    </p>

    <% img_src = article_hero_image_url(@article) %>
    <% if img_src %>
      <figure class="article-hero-figure mt-5">
        <img class="w-full max-w-full" src="<%= img_src %>" alt="" loading="eager" decoding="async" />
        <% if @article.image_credit.present? %>
          <figcaption class="figure-caption mt-2 text-end font-body text-xs text-muted"><em><%= @article.image_credit %></em></figcaption>
        <% end %>
      </figure>
    <% elsif @article.image_credit.present? %>
      <p class="article-hero-figure mt-5 text-end font-body text-xs text-muted"><em><%= @article.image_credit %></em></p>
    <% end %>
  </header>

  <div class="lawrence-prose article-body max-w-measure <%= img_src.present? ? 'border-t border-line pt-6' : 'pt-2' %>">
    <% begin %>
      <%= @article.body %>
    <% rescue StandardError => e %>
      <% Rails.logger.error("[articles#show body id=#{@article.id}] #{e.class}: #{e.message}") %>
      <div class="trix-content"><p class="text-muted">Article text could not be loaded.</p></div>
    <% end %>
  </div>

  <% if admin_signed_in? %>
    <div class="mt-10 flex flex-wrap gap-4 border-t border-line pt-6 font-ui text-sm">
      <%= link_to "Edit", edit_article_path(@article), class: "text-accent hover:text-accentMuted" %>
      <%= button_to "Destroy", article_path(@article), method: :delete, data: { turbo_confirm: "Are you sure?" }, class: "cursor-pointer border-0 bg-transparent p-0 font-ui text-sm text-accentMuted underline decoration-line hover:text-accent" %>
    </div>
  <% end %>
</article>
