<!DOCTYPE html>
<html>
  <head>
    <%= render "shared/theme_head" %>
    <title>The Lawrence</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">
    <meta name="robots" content="noindex, nofollow">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "homepage", "data-turbo-track": "reload" %>

    <% if Rails.env.production? %>
      <!-- Global site tag (gtag.js) - Google Analytics -->
      <script async src="https://www.googletagmanager.com/gtag/js?id=G-2QKWP06MCT"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', 'G-2QKWP06MCT');
      </script>
    <% end %>
  </head>

  <body data-bs-spy="scroll">
    <%= render "shared/popup" %>
    <% if notice.present? || alert.present? %>
      <div class="border-b border-line bg-paper px-3 py-2 text-center font-ui text-sm text-ink">
        <% if notice.present? %><div role="status"><%= notice %></div><% end %>
        <% if alert.present? %><div role="alert" class="text-accentMuted"><%= alert %></div><% end %>
      </div>
    <% end %>
    <% if @home %>
      <div class="lawrence-app min-h-screen bg-paper text-ink">
        <%= yield %>
      </div>
    <% else %>
      <div class="lawrence-app bg-paper">
        <%= render "shared/header" %>
        <main>
          <div class="site-container py-8 sm:py-10">
            <% show_section_sidebar = @section_page && @section_featured.present? %>
            <% show_default_sidebar = !@section_page %>
            <% show_sidebar = show_section_sidebar || show_default_sidebar %>
            <div class="grid gap-10 lg:grid-cols-12 lg:gap-12">
              <div class="min-w-0 <%= show_sidebar ? 'lg:col-span-8' : 'lg:col-span-12' %>">
                <%= yield %>
              </div>
              <% if show_section_sidebar %>
                <div class="hidden min-w-0 lg:col-span-4 lg:block">
                  <div class="section-sidebar-column">
                    <%= render "shared/sidebar" %>
                  </div>
                </div>
              <% elsif show_default_sidebar %>
                <div class="hidden min-w-0 lg:col-span-4 lg:block lg:border-l lg:border-line lg:pl-10">
                  <%= render "shared/sidebar" %>
                </div>
              <% end %>
            </div>
          </div>
        </main>
        <%= render "shared/footer" %>
      </div>
    <% end %>
    <% if admin_signed_in? %>
      <nav class="lawrence-app editor-toolbar" aria-label="Editor tools">
        <div class="editor-toolbar__inner">
          <%= link_to "New Issue", new_issue_path, class: "editor-toolbar__link" %>
          <%= link_to "New Author", new_author_path, class: "editor-toolbar__link" %>
          <%= link_to "New Article", new_article_path, class: "editor-toolbar__link" %>
          <a class="editor-toolbar__link" href="/crossword/edit">Edit Crossword</a>
          <a class="editor-toolbar__link editor-toolbar__link--muted" href="/admins/sign_out">Sign out</a>
        </div>
      </nav>
    <% end %>

    <% if Rails.env.production? %>
      <script>
        document.addEventListener('turbolinks:load', function() {
          if (typeof gtag === 'function') {
            gtag('config', 'G-2QKWP06MCT', {
              'page_path': window.location.pathname
            });
          }
        });
      </script>
    <% end %>

    <%= javascript_importmap_tags %>
  </body>
</html>
