<div class="space-y-10">
  <h1 class="font-display text-4xl font-semibold tracking-tight text-ink">Search</h1>

  <form method="GET" class="max-w-xl space-y-6 border-b border-line pb-10">
    <div>
      <label for="searchInput" class="block font-ui text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-muted">Query</label>
      <input name="query" type="text" id="searchInput" placeholder="Search…" class="mt-2 w-full border border-line bg-white px-3 py-2.5 font-body text-ink shadow-sm transition-colors focus:border-accent focus:outline-none focus:ring-1 focus:ring-accent" />
    </div>
    <fieldset>
      <legend class="block font-ui text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-muted">Search in</legend>
      <div class="mt-3 flex flex-wrap gap-6 font-ui text-sm text-ink">
        <label class="inline-flex cursor-pointer items-center gap-2">
          <input class="border-line text-accent focus:ring-accent" type="radio" name="type" value="articles" checked>
          Articles
        </label>
        <label class="inline-flex cursor-pointer items-center gap-2">
          <input class="border-line text-accent focus:ring-accent" type="radio" name="type" value="authors" id="searchRadio2">
          Authors
        </label>
      </div>
    </fieldset>
    <button type="submit" class="inline-flex border border-ink bg-ink px-5 py-2.5 font-ui text-[0.65rem] font-semibold uppercase tracking-[0.16em] text-paper transition-colors duration-editorial hover:bg-accent">Search</button>
  </form>

  <div class="space-y-6">
    <% if @error %>
      <p class="font-body text-muted">Error in query &ldquo;<%= @query %>&rdquo;</p>
    <% else %>
      <p class="font-body text-muted">Results for &ldquo;<%= @query %>&rdquo;</p>
    <% end %>

    <% unless @articles.nil? %>
      <div class="grid gap-10 sm:grid-cols-2">
        <% @articles.each do |article| %>
          <article class="border-t border-line pt-6">
            <a href="<%= url_for article %>" class="editorial-link block">
              <h2 class="font-display text-xl font-semibold leading-snug text-ink transition-colors duration-editorial hover:text-accent"><%= article.title %></h2>
              <p class="mt-2 font-ui text-xs text-muted">
                <% article.authors.each_with_index do |author, i| %>
                  <a href="<%= url_for author %>" class="editorial-link text-muted hover:text-ink"><%= author.fullname %><%= author.gradyear.blank? ? "" : " ’#{author.gradyear.to_s[-2..]}" %></a><%= (article.authors.count > 2 && i != article.authors.count - 1) ? ", " : "" %><%= (article.authors.count > 1 && i == article.authors.count - 2) ? " and " : "" %>
                <% end %>
                <span class="text-line"> | </span>
                <span class="font-medium text-ink"><%= article.section %></span>
              </p>
              <p class="mt-3 font-body text-sm leading-relaxed text-muted line-clamp-4">
                <%= (lambda { |text| text.split[0...[text.length, 30].min].join(" ") }).call(article.body.to_plain_text) %>…
              </p>
            </a>
          </article>
        <% end %>
      </div>
    <% end %>

    <% unless @authors.nil? %>
      <ul class="divide-y divide-line border-t border-line">
        <% @authors.each do |author| %>
          <li class="py-4">
            <a href="<%= url_for author %>" class="editorial-link block">
              <span class="font-display text-lg font-semibold text-ink hover:text-accent"><%= author.fullname %><%= author.gradyear.blank? ? "" : " ’#{author.gradyear.to_s[-2..]}" %><%= author.position.present? ? " (#{author.position})" : "" %></span>
              <p class="mt-1 font-ui text-sm text-muted"><%= author.articles.length %> article<%= author.articles.length == 1 ? "" : "s" %></p>
            </a>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
