<style>
.crossword-editor {
  max-width: 1000px;
  margin: 0 auto;
}
.crossword-editor h1 {
  margin-bottom: 24px;
}
.grid-wrapper {
  overflow-x: auto;
  margin-bottom: 20px;
  padding: 10px;
  background: #e8e8e8;
  border-radius: 8px;
}
.grid-row {
  display: flex;
}
.grid-cell {
  width: 36px;
  height: 36px;
  min-width: 36px;
  border: 1px solid #999;
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  position: relative;
  background: #1a1a1a;
  transition: background 0.1s;
}
.grid-cell.active {
  background: #fff;
}
.grid-cell .cell-num {
  position: absolute;
  top: 1px;
  left: 2px;
  font-size: 9px;
  font-weight: bold;
  color: #333;
  pointer-events: none;
}
.grid-cell input {
  width: 100%;
  height: 100%;
  border: none;
  background: transparent;
  text-align: center;
  font-size: 16px;
  font-weight: bold;
  text-transform: uppercase;
  cursor: pointer;
}
.grid-cell input:focus {
  outline: 2px solid #cfb53b;
  background: #f5f0dc;
}
.settings-section {
  background: #f8f9fa;
  padding: 20px;
  border-radius: 8px;
  margin-bottom: 24px;
}
.size-input {
  width: 70px;
  text-align: center;
}
.mode-btn {
  padding: 8px 16px;
  border: 2px solid #333;
  border-radius: 4px;
  background: #fff;
  cursor: pointer;
  margin-right: 8px;
  font-weight: 600;
}
.mode-btn.active {
  background: #cfb53b;
  color: #000;
  border-color: #cfb53b;
}
.help-text {
  background: #f5f5f5;
  border: 1px solid #ccc;
  border-radius: 4px;
  padding: 12px;
  margin-bottom: 16px;
}
</style>

<div class="crossword-editor">
  <h1>Edit Crossword Puzzle</h1>

  <% if @all_crosswords.present? && @all_crosswords.count > 0 %>
  <div class="settings-section mb-4">
    <h5>Saved Crosswords</h5>
    <table class="table table-sm table-hover">
      <thead>
        <tr>
          <th>Release Date</th>
          <th>Grid Size</th>
          <th>Created</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% @all_crosswords.each do |cw| %>
          <% 
            puzzle_data = begin
              cw.puzzle_data.is_a?(String) ? JSON.parse(cw.puzzle_data) : (cw.puzzle_data || {})
            rescue
              {}
            end
            rows = puzzle_data['rows'] || puzzle_data['size'] || '?'
            cols = puzzle_data['cols'] || puzzle_data['size'] || '?'
          %>
          <tr class="<%= cw.id == @crossword&.id ? 'table-primary' : '' %>">
            <td><%= cw.release_date&.strftime("%b %-d, %Y") || 'Not set' %></td>
            <td><%= rows %>×<%= cols %></td>
            <td><%= cw.created_at.strftime("%b %-d, %Y %l:%M %p") %></td>
            <td class="d-flex gap-2 align-items-center">
              <a href="/crossword/edit/<%= cw.id %>" class="btn btn-sm btn-outline-primary">Edit</a>
              <%= button_to "Delete", destroy_crossword_path(cw), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this crossword?" }, class: "btn btn-sm btn-outline-danger", form: { style: "display: inline;" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <a href="/crossword/edit" class="btn btn-success btn-sm">+ Create New Crossword</a>
  </div>
  <% end %>

  <%= form_with model: @crossword, url: crossword_path, method: :patch, local: true do |f| %>
    <%= f.hidden_field :puzzle_data, id: 'puzzle_data_field' %>
    
    <div class="settings-section">
      <div class="row">
        <div class="col-md-3">
          <h5>Release Date</h5>
          <%= f.date_field :release_date, class: 'form-control', style: 'max-width: 180px;', value: @crossword&.release_date || Date.today %>
        </div>
        <div class="col-md-4">
          <h5>Grid Size</h5>
          <div class="d-flex align-items-center gap-2">
            <input type="number" id="gridRows" class="form-control size-input" min="3" max="20" value="10">
            <span>×</span>
            <input type="number" id="gridCols" class="form-control size-input" min="3" max="20" value="10">
            <button type="button" class="btn btn-secondary btn-sm" onclick="resizeGrid()">Apply</button>
          </div>
        </div>
        <div class="col-md-5">
          <h5>Edit Mode</h5>
          <button type="button" class="mode-btn active" id="shapeMode" onclick="setMode('shape')">1. Draw Shape</button>
          <button type="button" class="mode-btn" id="letterMode" onclick="setMode('letter')">2. Fill Letters</button>
        </div>
      </div>
    </div>

    <div class="help-text" id="helpText">
      <strong>Step 1: Draw Shape</strong> - Click cells to toggle them on (white) or off (black). Create your crossword shape!
    </div>

    <h5>Grid <span id="gridSizeLabel" class="text-muted">(10×10)</span></h5>
    <div class="grid-wrapper">
      <div id="editor-grid"></div>
    </div>

    <div class="mb-4">
      <button type="button" class="btn btn-secondary" onclick="generateClues()">Generate Clues & Numbers</button>
      <button type="button" class="btn btn-outline-secondary" onclick="clearAll()">Clear All</button>
      <button type="button" class="btn btn-outline-secondary" onclick="invertGrid()">Invert Colors</button>
    </div>

    <div class="row">
      <div class="col-md-6">
        <h5>Across Clues</h5>
        <div id="across-clues"><p class="text-muted">Draw your shape, add letters, then click "Generate Clues & Numbers"</p></div>
      </div>
      <div class="col-md-6">
        <h5>Down Clues</h5>
        <div id="down-clues"></div>
      </div>
    </div>

    <div class="mt-4 mb-5">
      <%= f.submit 'Save Crossword', class: 'btn btn-primary btn-lg' %>
      <a href="/crossword" class="btn btn-outline-secondary btn-lg">Cancel</a>
    </div>
  <% end %>
</div>

<script>
let puzzle = {
  rows: 10,
  cols: 10,
  grid: [],
  clues: { across: {}, down: {} }
};

let editMode = 'shape'; // 'shape' or 'letter'
let isMouseDown = false;
let paintValue = null; // For drag painting

<% if @crossword&.puzzle_data.present? %>
(function() {
  let loaded = <%= raw @crossword.puzzle_data.is_a?(String) ? @crossword.puzzle_data : @crossword.puzzle_data.to_json %>;
  if (typeof loaded === 'string') loaded = JSON.parse(loaded);
  if (loaded && loaded.grid) {
    puzzle = loaded;
    puzzle.rows = puzzle.rows || puzzle.size || puzzle.grid.length;
    puzzle.cols = puzzle.cols || puzzle.size || (puzzle.grid[0] ? puzzle.grid[0].length : 10);
  }
})();
<% end %>

function initEditor() {
  document.getElementById('gridRows').value = puzzle.rows || 10;
  document.getElementById('gridCols').value = puzzle.cols || 10;
  
  // Initialize empty grid if needed
  if (!puzzle.grid || puzzle.grid.length === 0) {
    puzzle.grid = [];
    for (let r = 0; r < puzzle.rows; r++) {
      puzzle.grid[r] = [];
      for (let c = 0; c < puzzle.cols; c++) {
        puzzle.grid[r][c] = '#';
      }
    }
  }
  
  buildGrid();
  
  // Check if puzzle has content - if so, load it properly
  const hasContent = puzzle.grid.some(row => row.some(cell => cell && cell !== '#'));
  if (hasContent) {
    // Existing puzzle - generate clues and switch to letter mode
    generateClues();
    setMode('letter');
  } else {
    setMode('shape');
  }
  
  // Mouse up anywhere ends drag
  document.addEventListener('mouseup', () => { isMouseDown = false; paintValue = null; });
}

function buildGrid() {
  const rows = puzzle.rows;
  const cols = puzzle.cols;
  const container = document.getElementById('editor-grid');
  container.innerHTML = '';
  
  document.getElementById('gridSizeLabel').textContent = `(${rows}×${cols})`;
  
  for (let r = 0; r < rows; r++) {
    const rowDiv = document.createElement('div');
    rowDiv.className = 'grid-row';
    
    for (let c = 0; c < cols; c++) {
      const cell = document.createElement('div');
      cell.className = 'grid-cell';
      cell.dataset.row = r;
      cell.dataset.col = c;
      
      const val = (puzzle.grid[r] && puzzle.grid[r][c]) ? puzzle.grid[r][c] : '#';
      const isActive = val && val !== '#';
      
      if (isActive) {
        cell.classList.add('active');
        const input = document.createElement('input');
        input.type = 'text';
        input.maxLength = 1;
        input.value = val;
        input.dataset.row = r;
        input.dataset.col = c;
        input.addEventListener('input', onLetterInput);
        input.addEventListener('keydown', onLetterKeydown);
        input.addEventListener('mousedown', (e) => e.stopPropagation());
        input.addEventListener('dblclick', (e) => {
          e.stopPropagation();
          toggleCell(r, c, false); // Turn cell black on double-click
        });
        cell.appendChild(input);
      }
      
      cell.addEventListener('mousedown', (e) => onCellMouseDown(e, r, c));
      cell.addEventListener('mouseenter', (e) => onCellMouseEnter(e, r, c));
      cell.addEventListener('dblclick', (e) => toggleCell(r, c, !cell.classList.contains('active')));
      
      rowDiv.appendChild(cell);
    }
    container.appendChild(rowDiv);
  }
  
  updatePuzzleData();
}

function setMode(mode) {
  editMode = mode;
  document.getElementById('shapeMode').classList.toggle('active', mode === 'shape');
  document.getElementById('letterMode').classList.toggle('active', mode === 'letter');
  
  if (mode === 'shape') {
    document.getElementById('helpText').innerHTML = '<strong>Step 1: Draw Shape</strong> - Click cells to toggle them on (white) or off (black). Create your crossword shape!';
  } else {
    document.getElementById('helpText').innerHTML = '<strong>Step 2: Fill Letters</strong> - Type letters in the white cells. <em>Double-click</em> a cell to turn it black. Then click "Generate Clues & Numbers" to auto-number.';
  }
}

function onCellMouseDown(e, r, c) {
  e.preventDefault();
  isMouseDown = true;
  
  if (editMode === 'shape') {
    const cell = e.target.closest('.grid-cell');
    const isActive = cell.classList.contains('active');
    paintValue = !isActive; // Toggle: if active, paint inactive; if inactive, paint active
    toggleCell(r, c, paintValue);
  } else if (editMode === 'letter') {
    const input = e.target.closest('.grid-cell')?.querySelector('input');
    if (input) input.focus();
  }
}

function onCellMouseEnter(e, r, c) {
  if (!isMouseDown || editMode !== 'shape' || paintValue === null) return;
  toggleCell(r, c, paintValue);
}

function toggleCell(r, c, makeActive) {
  const cell = document.querySelector(`.grid-cell[data-row="${r}"][data-col="${c}"]`);
  if (!cell) return;
  
  if (makeActive) {
    cell.classList.add('active');
    puzzle.grid[r][c] = '';
    
    if (!cell.querySelector('input')) {
      const input = document.createElement('input');
      input.type = 'text';
      input.maxLength = 1;
      input.value = '';
      input.dataset.row = r;
      input.dataset.col = c;
      input.addEventListener('input', onLetterInput);
      input.addEventListener('keydown', onLetterKeydown);
      input.addEventListener('mousedown', (e) => e.stopPropagation());
      cell.appendChild(input);
    }
  } else {
    cell.classList.remove('active');
    puzzle.grid[r][c] = '#';
    const input = cell.querySelector('input');
    if (input) input.remove();
  }
  
  // Remove cell numbers when shape changes
  cell.querySelectorAll('.cell-num').forEach(n => n.remove());
  
  updatePuzzleData();
}

function onLetterInput(e) {
  const val = e.target.value.toUpperCase();
  e.target.value = val;
  const r = parseInt(e.target.dataset.row);
  const c = parseInt(e.target.dataset.col);
  puzzle.grid[r][c] = val || '';
  updatePuzzleData();
  
  if (val) {
    // Move to next cell
    const nextInput = document.querySelector(`.grid-cell[data-row="${r}"][data-col="${c + 1}"] input`);
    if (nextInput) nextInput.focus();
  }
}

function onLetterKeydown(e) {
  const r = parseInt(e.target.dataset.row);
  const c = parseInt(e.target.dataset.col);
  
  if (e.key === 'ArrowRight') {
    e.preventDefault();
    const next = document.querySelector(`.grid-cell[data-row="${r}"][data-col="${c + 1}"] input`);
    if (next) next.focus();
  } else if (e.key === 'ArrowLeft') {
    e.preventDefault();
    const next = document.querySelector(`.grid-cell[data-row="${r}"][data-col="${c - 1}"] input`);
    if (next) next.focus();
  } else if (e.key === 'ArrowDown') {
    e.preventDefault();
    const next = document.querySelector(`.grid-cell[data-row="${r + 1}"][data-col="${c}"] input`);
    if (next) next.focus();
  } else if (e.key === 'ArrowUp') {
    e.preventDefault();
    const next = document.querySelector(`.grid-cell[data-row="${r - 1}"][data-col="${c}"] input`);
    if (next) next.focus();
  } else if (e.key === 'Backspace' && !e.target.value) {
    e.preventDefault();
    const prev = document.querySelector(`.grid-cell[data-row="${r}"][data-col="${c - 1}"] input`);
    if (prev) prev.focus();
  }
}

function resizeGrid() {
  const newRows = Math.min(20, Math.max(3, parseInt(document.getElementById('gridRows').value) || 10));
  const newCols = Math.min(20, Math.max(3, parseInt(document.getElementById('gridCols').value) || 10));
  
  document.getElementById('gridRows').value = newRows;
  document.getElementById('gridCols').value = newCols;
  
  const oldGrid = puzzle.grid || [];
  puzzle.grid = [];
  puzzle.rows = newRows;
  puzzle.cols = newCols;
  
  for (let r = 0; r < newRows; r++) {
    puzzle.grid[r] = [];
    for (let c = 0; c < newCols; c++) {
      puzzle.grid[r][c] = (oldGrid[r] && oldGrid[r][c]) ? oldGrid[r][c] : '#';
    }
  }
  
  buildGrid();
}

function clearAll() {
  if (!confirm('Clear the entire grid?')) return;
  for (let r = 0; r < puzzle.rows; r++) {
    for (let c = 0; c < puzzle.cols; c++) {
      puzzle.grid[r][c] = '#';
    }
  }
  puzzle.clues = { across: {}, down: {} };
  buildGrid();
  document.getElementById('across-clues').innerHTML = '<p class="text-muted">Draw your shape first</p>';
  document.getElementById('down-clues').innerHTML = '';
}

function invertGrid() {
  for (let r = 0; r < puzzle.rows; r++) {
    for (let c = 0; c < puzzle.cols; c++) {
      if (puzzle.grid[r][c] === '#') {
        puzzle.grid[r][c] = '';
      } else {
        puzzle.grid[r][c] = '#';
      }
    }
  }
  buildGrid();
}

function generateClues() {
  const rows = puzzle.rows;
  const cols = puzzle.cols;
  const grid = puzzle.grid;
  
  // Save old clues to match by position
  const oldAcross = puzzle.clues?.across || {};
  const oldDown = puzzle.clues?.down || {};
  
  // Helper to find existing clue by position
  function findClueByPos(cluesObj, row, col) {
    for (const [num, data] of Object.entries(cluesObj)) {
      if (data.row === row && data.col === col) return data.clue || '';
    }
    return '';
  }
  
  // First, add numbers to cells
  document.querySelectorAll('.cell-num').forEach(n => n.remove());
  
  const acrossDiv = document.getElementById('across-clues');
  const downDiv = document.getElementById('down-clues');
  acrossDiv.innerHTML = '';
  downDiv.innerHTML = '';
  
  let num = 1;
  const newAcross = {};
  const newDown = {};
  
  for (let r = 0; r < rows; r++) {
    for (let c = 0; c < cols; c++) {
      if (!grid[r] || !grid[r][c] || grid[r][c] === '#') continue;
      
      // Check for across start (2+ letters)
      const leftBlocked = c === 0 || !grid[r][c-1] || grid[r][c-1] === '#';
      const hasRight = c < cols-1 && grid[r][c+1] && grid[r][c+1] !== '#';
      const acrossStart = leftBlocked && hasRight;
      
      // Check for down start (2+ letters)
      const topBlocked = r === 0 || !grid[r-1] || !grid[r-1][c] || grid[r-1][c] === '#';
      const hasBelow = r < rows-1 && grid[r+1] && grid[r+1][c] && grid[r+1][c] !== '#';
      const downStart = topBlocked && hasBelow;
      
      if (acrossStart || downStart) {
        const clueNum = num++;
        
        // Add number to cell
        const cell = document.querySelector(`.grid-cell[data-row="${r}"][data-col="${c}"]`);
        if (cell) {
          const numSpan = document.createElement('span');
          numSpan.className = 'cell-num';
          numSpan.textContent = clueNum;
          cell.appendChild(numSpan);
        }
        
        if (acrossStart) {
          let word = '';
          for (let cc = c; cc < cols && grid[r][cc] && grid[r][cc] !== '#'; cc++) {
            word += grid[r][cc] || '?';
          }
          const existingClue = findClueByPos(oldAcross, r, c);
          newAcross[clueNum] = { clue: existingClue, row: r, col: c, word: word };
          
          const div = document.createElement('div');
          div.className = 'mb-3';
          div.innerHTML = `
            <label class="form-label"><strong>${clueNum}.</strong> ${word.replace(/\?/g, '_')} <span class="text-muted">(${word.length})</span></label>
            <input type="text" class="form-control clue-input" data-num="${clueNum}" data-dir="across" value="${escapeHtml(existingClue)}" placeholder="Enter clue...">
          `;
          acrossDiv.appendChild(div);
        }
        
        if (downStart) {
          let word = '';
          for (let rr = r; rr < rows && grid[rr] && grid[rr][c] && grid[rr][c] !== '#'; rr++) {
            word += grid[rr][c] || '?';
          }
          const existingClue = findClueByPos(oldDown, r, c);
          newDown[clueNum] = { clue: existingClue, row: r, col: c, word: word };
          
          const div = document.createElement('div');
          div.className = 'mb-3';
          div.innerHTML = `
            <label class="form-label"><strong>${clueNum}.</strong> ${word.replace(/\?/g, '_')} <span class="text-muted">(${word.length})</span></label>
            <input type="text" class="form-control clue-input" data-num="${clueNum}" data-dir="down" value="${escapeHtml(existingClue)}" placeholder="Enter clue...">
          `;
          downDiv.appendChild(div);
        }
      }
    }
  }
  
  puzzle.clues = { across: newAcross, down: newDown };
  
  if (Object.keys(newAcross).length === 0) {
    acrossDiv.innerHTML = '<p class="text-muted">No across words found (need 2+ connected cells)</p>';
  }
  if (Object.keys(newDown).length === 0) {
    downDiv.innerHTML = '<p class="text-muted">No down words found (need 2+ connected cells)</p>';
  }
  
  // Add listeners for clue inputs
  document.querySelectorAll('.clue-input').forEach(inp => {
    inp.addEventListener('input', function() {
      const num = this.dataset.num;
      const dir = this.dataset.dir;
      if (puzzle.clues[dir][num]) {
        puzzle.clues[dir][num].clue = this.value;
      }
      updatePuzzleData();
    });
  });
  
  updatePuzzleData();
}

function updatePuzzleData() {
  puzzle.size = Math.max(puzzle.rows, puzzle.cols);
  document.getElementById('puzzle_data_field').value = JSON.stringify(puzzle);
}

function escapeHtml(str) {
  if (!str) return '';
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
}

document.addEventListener('DOMContentLoaded', initEditor);
</script>
