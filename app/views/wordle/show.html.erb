<style>
.grid {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5px;
  margin: 20px 0;
}

.wordle-row {
  display: flex;
  gap: 5px;
}

.tile {
  width: 60px;
  height: 60px;
  border: 2px solid #ccc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  font-weight: bold;
  text-transform: uppercase;
  background-color: white;
}

.correct { background-color: #6aaa64; color: white; border-color: #6aaa64; }
.present { background-color: #c9b458; color: white; border-color: #c9b458; }
.absent { background-color: #787c7e; color: white; border-color: #787c7e; }

#message-container {
  text-align: center;
  margin: 15px 0;
  font-size: 18px;
  font-weight: bold;
}

#keyboard-container {
  text-align: center;
  margin-top: 20px;
}

.keyboard-button {
  padding: 15px 12px;
  margin: 3px;
  border: none;
  border-radius: 4px;
  background-color: #d3d6da;
  font-size: 14px;
  font-weight: bold;
  cursor: pointer;
  min-width: 43px;
}

.keyboard-button:hover {
  background-color: #b5b8bc;
}
</style>

<script>
let currentRow = 1;        // Which row the player is typing in (1-6)
let currentTile = 1;       // Which tile in that row (1-5)
let currentGuess = "";     // The letters typed so far (e.g., "HE" or "HELLO")
let gameOver = false;      // Whether the game is over (true/false)

document.addEventListener("keydown", handleKeyPress);

function handleKeyPress(event) {
  // If game is over, ignore all key presses
  if (gameOver) return;
  
  // Get which key was pressed and make it uppercase
  const key = event.key.toUpperCase();
  
  // Decide what to do based on which key
  if (key === "ENTER") {
    submitGuess();           // Submit the current guess
  } else if (key === "BACKSPACE") {
    deleteLetter();          // Delete the last letter
  } else if (key.length === 1 && key >= "A" && key <= "Z") {
    addLetter(key);          // Add a letter to the guess
  }
  // Any other key (numbers, symbols, etc.) is ignored
}

function addLetter(letter) {
  // Can't add more than 5 letters
  if (currentGuess.length >= 5) return;
  
  // Add the letter to our guess string
  currentGuess += letter;
  
  // Find the tile element and put the letter in it
  const tile = document.getElementById(`tile-${currentRow}-${currentTile}`);
  tile.textContent = letter;
  
  // Move to the next tile
  currentTile++;
}

function deleteLetter() {
  // Can't delete if nothing typed
  if (currentGuess.length === 0) return;
  
  // Move back one tile
  currentTile--;
  
  // Clear that tile
  const tile = document.getElementById(`tile-${currentRow}-${currentTile}`);
  tile.textContent = "";
  
  // Remove the last letter from our guess
  currentGuess = currentGuess.slice(0, -1);
}

async function submitGuess() {
  // Must have exactly 5 letters
  if (currentGuess.length !== 5) {
    showMessage("Not enough letters");
    return;
  }
  
  // Send the guess to your Rails API
  const response = await fetch("/wordle/guess", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ guess: currentGuess })
  });
  
  // Get the response data
  const data = await response.json();
  
  // Color the tiles based on the result
  colorTiles(data.result);
  
  // Check if player won
  if (data.won) {
    showMessage("Congratulations! 🎉");
    gameOver = true;
    return;
  }
  
  // Check if player lost (used all 6 guesses)
  if (currentRow === 6) {
    showMessage("Game over!");
    gameOver = true;
    return;
  }
  
  // Move to the next row for the next guess
  currentRow++;
  currentTile = 1;
  currentGuess = "";
}

function colorTiles(result) {
  for (let i = 0; i < 5; i++) {
    const tile = document.getElementById(`tile-${currentRow}-${i + 1}`);
    
    // Add the appropriate CSS class
    tile.classList.add(result[i]);  // "correct", "present", or "absent"
  }
}

function showMessage(text) {
  const messageEl = document.getElementById("message-text");
  messageEl.textContent = text;
  
  // Optional: Clear the message after 2 seconds
  setTimeout(() => {
    messageEl.textContent = "";
  }, 2000);
}

// Add click handlers to all keyboard buttons
document.querySelectorAll(".keyboard-button").forEach(button => {
  button.addEventListener("click", () => {
    const key = button.id;  // The button's ID is the letter (e.g., "A", "ENTER")
    
    if (key === "ENTER") {
      submitGuess();
    } else if (key === "BACKSPACE") {
      deleteLetter();
    } else {
      addLetter(key);
    }
  });
});
</script>